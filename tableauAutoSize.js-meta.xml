            <property name="bottomOffset" type="Integer" label="Bottom Offset (px)" default="16"/>
            <property name="minHeight" type="Integer" label="Minimum Height (px)" default="400"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>